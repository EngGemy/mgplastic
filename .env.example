APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Admin panel URL path (not linked on the public website). Change on production.
# Example: ADMIN_PANEL_PATH=mg-cp-7k9x3
ADMIN_PANEL_PATH=admin

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sebakaa_app
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin AI Gateway (ChatGPT Custom GPT Actions + MCP HTTP)
# Long random secret — never commit the real value.
AI_GATEWAY_TOKEN=
AI_TOOLS_ALLOW_WRITE=false
AI_GATEWAY_RATE_LIMIT=60

# Google Gemini — ask questions on admin Decision Reports page
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=45

# WAHA WhatsApp API (OTP sync + queued alerts)
WAHA_URL=https://your-waha-host
WAHA_API_KEY=
WAHA_SESSION=default
WHATSAPP_ADMIN_PHONES=201030003186,218912159316
WHATSAPP_NOTIFY_ENABLED=true
# Fallback country code when local number has no 0+10/11 rule (Libya=218, Egypt=20)
WHATSAPP_DEFAULT_COUNTRY_CODE=218
# true = send invoice/order alerts immediately (no queue:work needed)
WAHA_SYNC_ALERTS=true
# Queue name when WAHA_SYNC_ALERTS=false (use default unless dedicated worker)
WAHA_QUEUE=default
# Link shown inside WhatsApp alerts (Play Store / deep link / website)
MG_APP_URL=

# Universal / App Links (WhatsApp → native screen)
# Public base must be the domain that serves this Laravel app (/open + /.well-known)
APP_LINKS_BASE=https://mg-plastic.com
APP_SCHEME=mgplastic
APP_PACKAGE=com.mgplastic.app
APP_ANDROID_URL=
APP_IOS_URL=
# Colon-separated SHA-256 fingerprint(s) from Play App Signing — replace placeholder
APP_ANDROID_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
# Apple Team ID (and optional full appID TEAMID.bundle)
APP_APPLE_TEAM_ID=TEAMIDXXXX
APP_APPLE_APP_ID=

# Optional brand/cover image for alerts (public https URL)
WAHA_BRAND_IMAGE_URL=
# OTP channels: whatsapp,sms (or one of them)
OTP_CHANNELS=whatsapp,sms

# WhatsApp customer alerts (orders + invoices).
# WHATSAPP_DRIVER=log|evolution|libyasms|http
WHATSAPP_DRIVER=log
WHATSAPP_SHARE_DAYS=30
# Evolution API (Baileys) — self-hosted, good for low volume (<1000 msgs)
# WHATSAPP_EVOLUTION_URL=https://your-evolution-host
# WHATSAPP_EVOLUTION_API_KEY=
# WHATSAPP_EVOLUTION_INSTANCE=mg-plastic
# WHATSAPP_EVOLUTION_VERSION=v2
# LibyaSMS WhatsApp API (https://docs.libyasms.com)
WHATSAPP_LIBYASMS_TOKEN=
WHATSAPP_LIBYASMS_INSTANCE_ID=
# WHATSAPP_LIBYASMS_URL=https://whatsapp.libyasms.com
# Generic HTTP gateway: POST JSON {to,phone,message,body}
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
