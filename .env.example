APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Admin panel URL path (not linked on the public website). Change on production.
# Example: ADMIN_PANEL_PATH=mg-cp-7k9x3
ADMIN_PANEL_PATH=admin

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sebakaa_app
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin AI Gateway (ChatGPT Custom GPT Actions + MCP HTTP)
# Long random secret — never commit the real value.
AI_GATEWAY_TOKEN=
AI_TOOLS_ALLOW_WRITE=false
AI_GATEWAY_RATE_LIMIT=60

# Google Gemini — ask questions on admin Decision Reports page
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=8
AI_DAILY_CALL_LIMIT=300

# Reputation / warranty / reminders (Africa/Tripoli)
REPUTATION_ENABLED=true
WARRANTY_ENABLED=true
WARRANTY_MIN_LEVEL=gold
WARRANTY_MIN_SCORE=70
WARRANTY_MIN_DISTRIBUTIONS=5
WARRANTY_DEFAULT_MONTHS=12
REMINDERS_ENABLED=false
REMINDERS_ADMIN_ONLY=true
REMINDERS_PER_HOUR=40
REMINDERS_DAILY_LIMIT=120
REMINDER_TIMEZONE=Africa/Tripoli

# WAHA WhatsApp API (OTP sync + queued alerts)
WAHA_URL=https://your-waha-host
WAHA_API_KEY=
# Exact WAHA session name (e.g. session_01m5…) — required, never hardcode in code
WAHA_SESSION=
WHATSAPP_ADMIN_PHONES=201030003186,218912159316
WHATSAPP_NOTIFY_ENABLED=true
# Fallback country code when local number has no 0+10/11 rule (Libya=218, Egypt=20)
WHATSAPP_DEFAULT_COUNTRY_CODE=218
# true = send invoice/order alerts immediately (no queue:work needed)
WAHA_SYNC_ALERTS=true
# Queue name when WAHA_SYNC_ALERTS=false
WAHA_QUEUE=whatsapp
# Anti-ban pacing (seconds, random between min–max; OTP never delayed)
WHATSAPP_DELAY_MIN=1
WHATSAPP_DELAY_MAX=3
# Daily cap for non-OTP sends (whatsapp_logs). OTP always excluded.
WHATSAPP_DAILY_LIMIT=50
# false = admins only (safe for staging tests)
WHATSAPP_NOTIFY_CUSTOMERS=true
# Skip related alerts to same phone+reference within N seconds (0=off)
WHATSAPP_COALESCE_SECONDS=60
# Health / daily-limit alert emails (comma-separated)
WHATSAPP_ALERT_EMAILS=
# Card size 1080x1350 (portrait) or 1080x1080; JPEG quality
WHATSAPP_CARD_SIZE=1080x1350
WHATSAPP_CARD_QUALITY=85
# Link shown inside WhatsApp alerts (Play Store / deep link / website)
MG_APP_URL=

# Universal / App Links (WhatsApp → native screen)
# Public base must be the domain that serves this Laravel app (/open + /.well-known)
APP_LINKS_BASE=https://mg-plastic.com
APP_SCHEME=mgplastic
APP_PACKAGE=com.MgTools
APP_ANDROID_URL=
APP_IOS_URL=
# Play App Signing SHA-256 fingerprint(s), comma-separated
APP_ANDROID_SHA256=2C:C3:68:A2:7B:57:DE:E8:19:DA:0A:05:B3:87:58:B6:68:1F:7D:94:BD:C6:A9:D8:68:18:FD:89:8A:C8:D9:E1,A7:96:F1:20:2C:86:8E:E1:ED:9A:70:D1:F8:7F:AE:5B:89:E5:7E:98:F7:A0:50:18:36:86:A4:BE:8F:E0:59:4B
# Apple Team ID + full appID (TeamID.iOS bundle) — never the Android package
APP_APPLE_TEAM_ID=LP86Z6FUHH
APP_APPLE_APP_ID=LP86Z6FUHH.com.mgPlumbers.app
APP_IOS_BUNDLE_ID=com.mgPlumbers.app

# Website + app testimonials (Gemini daily Libyan 5★ reviews about MG products)
TESTIMONIALS_ENABLED=true
TESTIMONIALS_DAILY_GENERATE=true
TESTIMONIALS_DAILY_COUNT=2
TESTIMONIALS_PUBLIC_LIMIT=24

# Optional brand/cover image for alerts (public https URL)
WAHA_BRAND_IMAGE_URL=
# OTP channels: whatsapp,sms (or one of them)
OTP_CHANNELS=whatsapp,sms

# WhatsApp customer alerts (orders + invoices).
# WHATSAPP_DRIVER=log|evolution|libyasms|http
WHATSAPP_DRIVER=log
WHATSAPP_SHARE_DAYS=30
# Evolution API (Baileys) — self-hosted, good for low volume (<1000 msgs)
# WHATSAPP_EVOLUTION_URL=https://your-evolution-host
# WHATSAPP_EVOLUTION_API_KEY=
# WHATSAPP_EVOLUTION_INSTANCE=mg-plastic
# WHATSAPP_EVOLUTION_VERSION=v2
# LibyaSMS WhatsApp API (https://docs.libyasms.com)
WHATSAPP_LIBYASMS_TOKEN=
WHATSAPP_LIBYASMS_INSTANCE_ID=
# WHATSAPP_LIBYASMS_URL=https://whatsapp.libyasms.com
# Generic HTTP gateway: POST JSON {to,phone,message,body}
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
